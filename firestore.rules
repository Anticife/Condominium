rules_version = '2';

// Mi Conjunto en Línea — reglas de seguridad Multi-Tenant (plan Spark, sin Cloud Functions).
// Cada conjunto residencial vive aislado bajo `condominiums/{condoId}/...`.
// Todas las reglas de negocio (RN-B1 a RN-B7) y el aislamiento inter-tenant se validan aquí.
// Todo lo que no tenga un `match` explícito queda denegado por defecto.

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES HELPER GLOBALES (SCRUM-6 + MULTI-TENANCY)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return hasProfile() && getUserData().isActive == true;
    }

    function myCondoId() {
      return getUserData().get('condominiumId', null);
    }

    // Un usuario desactivado (RF-02) pierde todos sus permisos.
    function hasRole(role) {
      return isActiveUser() && getUserData().role == role;
    }

    function inCondo(condoId) {
      return isActiveUser() && myCondoId() == condoId;
    }

    function hasCondoRole(condoId, role) {
      return inCondo(condoId) && getUserData().role == role;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function myUnitId() {
      return getUserData().get('unitId', null);
    }

    function isResidentOf(condoId, apartmentId) {
      return hasCondoRole(condoId, 'residente') && myUnitId() == apartmentId;
    }

    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function condoPath(condoId) {
      return /databases/$(database)/documents/condominiums/$(condoId);
    }

    function apartmentPath(condoId, apartmentId) {
      return /databases/$(database)/documents/condominiums/$(condoId)/apartments/$(apartmentId);
    }

    // ==========================================
    // USUARIOS (users/{userId}) — SCRUM-6 + AISLAMIENTO TENANT
    // ==========================================
    match /users/{userId} {
      // Un usuario lee su propio perfil; la administradora solo lee usuarios de SU conjunto.
      allow read: if isSelf(userId)
        || (hasRole('administradora')
            && myCondoId() != null
            && resource.data.condominiumId == myCondoId());

      // Autorregistro: siempre como residente, activo y SIN conjunto ni apartamento.
      allow create: if (hasRole('administradora')
            && myCondoId() != null
            && request.resource.data.condominiumId == myCondoId())
        || (isSelf(userId)
            && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'isActive', 'condominiumId', 'createdAt'])
            && request.resource.data.uid == userId
            && request.resource.data.role == 'residente'
            && request.resource.data.isActive == true
            && request.resource.data.get('condominiumId', null) == null
            && request.resource.data.createdAt == request.time);

      // Cuatro caminos seguros de actualización:
      // 1. El propio usuario edita su contacto (displayName, phone).
      // 2. Usuario sin conjunto se une a un conjunto activo existente (siempre como residente).
      // 3. Usuario sin conjunto crea un conjunto nuevo en el mismo batch (queda como administradora de SU conjunto).
      // 4. Administradora del mismo conjunto gestiona roles, estado y unidad (sin poder auto-desactivarse ni tocar otros conjuntos).
      allow update: if (isSelf(userId) && changesOnly(['displayName', 'phone']))
        || (isSelf(userId)
            && isActiveUser()
            && resource.data.get('condominiumId', null) == null
            && changesOnly(['condominiumId', 'role'])
            && request.resource.data.role == 'residente'
            && isNonEmptyString(request.resource.data.condominiumId)
            && exists(condoPath(request.resource.data.condominiumId))
            && get(condoPath(request.resource.data.condominiumId)).data.isActive == true)
        || (isSelf(userId)
            && isActiveUser()
            && resource.data.get('condominiumId', null) == null
            && changesOnly(['condominiumId', 'role'])
            && request.resource.data.role == 'administradora'
            && isNonEmptyString(request.resource.data.condominiumId)
            && existsAfter(condoPath(request.resource.data.condominiumId))
            && getAfter(condoPath(request.resource.data.condominiumId)).data.ownerUid == request.auth.uid)
        || (hasRole('administradora')
            && myCondoId() != null
            && resource.data.condominiumId == myCondoId()
            && changesOnly(['displayName', 'phone', 'role', 'isActive', 'unitId', 'towerId'])
            && request.resource.data.role in ['residente', 'portero', 'administradora']
            && (!isSelf(userId) || changesOnly(['displayName', 'phone'])));

      allow delete: if false;
    }

    // ==========================================
    // CÓDIGOS DE INVITACIÓN (joinCodes/{code}) — MULTI-TENANCY
    // ==========================================
    match /joinCodes/{code} {
      // Solo lectura puntual por código exacto (no se puede listar el catálogo de conjuntos).
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['code', 'condominiumId', 'condominiumName', 'isActive', 'createdAt'])
        && request.resource.data.code == code
        && code.matches('^[A-Z0-9-]{4,24}$')
        && isNonEmptyString(request.resource.data.condominiumId)
        && isNonEmptyString(request.resource.data.condominiumName)
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && ((myCondoId() == null
              && existsAfter(condoPath(request.resource.data.condominiumId))
              && getAfter(condoPath(request.resource.data.condominiumId)).data.ownerUid == request.auth.uid)
            || hasCondoRole(request.resource.data.condominiumId, 'administradora'));

      allow update: if hasCondoRole(resource.data.condominiumId, 'administradora')
        && changesOnly(['condominiumName', 'isActive'])
        && isNonEmptyString(request.resource.data.condominiumName)
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // ==========================================
    // CONJUNTOS RESIDENCIALES (condominiums/{condoId})
    // ==========================================
    match /condominiums/{condoId} {
      allow read: if inCondo(condoId);

      // Creación autoservicio en plan Spark: un usuario activo sin conjunto crea el conjunto
      // y reserva su código de invitación en el mismo batch.
      allow create: if isActiveUser()
        && myCondoId() == null
        && request.resource.data.keys().hasOnly(['id', 'name', 'nit', 'address', 'city', 'joinCode', 'ownerUid', 'isActive', 'createdAt'])
        && request.resource.data.id == condoId
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.nit is string
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.matches('^[A-Z0-9-]{4,24}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && getAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.condominiumId == condoId;

      allow update: if hasCondoRole(condoId, 'administradora')
        && changesOnly(['name', 'nit', 'address', 'city'])
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.nit is string
        && request.resource.data.address is string
        && request.resource.data.city is string;

      allow delete: if false;

      // ==========================================
      // TORRES Y APARTAMENTOS (CENSO) — SCRUM-10
      // ==========================================
      match /towers/{towerId} {
        allow read: if inCondo(condoId);
        allow create, update: if hasCondoRole(condoId, 'administradora')
          && request.resource.data.id == towerId
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.totalApartments is int;
        allow delete: if hasCondoRole(condoId, 'administradora');
      }

      match /apartments/{apartmentId} {
        allow read: if hasCondoRole(condoId, 'administradora')
          || hasCondoRole(condoId, 'portero')
          || isResidentOf(condoId, apartmentId);

        // Id determinista `${towerId}-${number}` (p. ej. T1-101) por conjunto.
        allow create: if hasCondoRole(condoId, 'administradora')
          && request.resource.data.id == apartmentId
          && apartmentId == request.resource.data.towerId + '-' + request.resource.data.number
          && exists(/databases/$(database)/documents/condominiums/$(condoId)/towers/$(request.resource.data.towerId))
          && request.resource.data.residentUids is list
          && request.resource.data.createdAt == request.time;

        // La torre y el número no cambian después de creado.
        allow update: if hasCondoRole(condoId, 'administradora')
          && changesOnly(['ownerName', 'residentUids'])
          && request.resource.data.residentUids is list;

        allow delete: if hasCondoRole(condoId, 'administradora');

        // Personas autorizadas a recibir paquetes (RN-B4, RN-B7 - Habeas Data).
        match /authorized/{authId} {
          function validAuthorized() {
            return isNonEmptyString(request.resource.data.fullName)
              && isNonEmptyString(request.resource.data.documentId)
              && request.resource.data.relation is string
              && request.resource.data.isActive is bool
              && request.resource.data.id == authId;
          }

          allow read: if hasCondoRole(condoId, 'administradora')
            || hasCondoRole(condoId, 'portero')
            || isResidentOf(condoId, apartmentId);

          allow create: if validAuthorized()
            && request.resource.data.registeredAt == request.time
            && (hasCondoRole(condoId, 'administradora')
                || (isResidentOf(condoId, apartmentId) && request.resource.data.relation != 'residente'));

          allow update: if validAuthorized()
            && request.resource.data.registeredAt == resource.data.registeredAt
            && (hasCondoRole(condoId, 'administradora')
                || (isResidentOf(condoId, apartmentId)
                    && resource.data.relation != 'residente'
                    && request.resource.data.relation != 'residente'));

          allow delete: if hasCondoRole(condoId, 'administradora')
            || (isResidentOf(condoId, apartmentId) && resource.data.relation != 'residente');
        }
      }

      // ==========================================
      // PAQUETERÍA (packages/{packageId}) — SCRUM-14, 17, 21
      // ==========================================
      match /packages/{packageId} {
        allow read: if hasCondoRole(condoId, 'portero')
          || hasCondoRole(condoId, 'administradora')
          || (hasCondoRole(condoId, 'residente') && resource.data.apartmentId == myUnitId());

        allow create: if (hasCondoRole(condoId, 'portero') || hasCondoRole(condoId, 'administradora'))
          && request.resource.data.keys().hasOnly(['trackingNumber', 'courier', 'towerId', 'apartmentId', 'recipientName', 'status', 'notes', 'receivedByPorteroId', 'receivedAt', 'createdAt'])
          && request.resource.data.status == 'Pendiente'
          && request.resource.data.receivedByPorteroId == request.auth.uid
          && request.resource.data.receivedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.towerId is string
          && request.resource.data.apartmentId is string
          && isNonEmptyString(request.resource.data.recipientName)
          && isNonEmptyString(request.resource.data.courier)
          && exists(apartmentPath(condoId, request.resource.data.apartmentId))
          && get(apartmentPath(condoId, request.resource.data.apartmentId)).data.towerId == request.resource.data.towerId;

        allow update: if (hasCondoRole(condoId, 'portero') || hasCondoRole(condoId, 'administradora'))
          && resource.data.status == 'Pendiente'
          && request.resource.data.status == 'Entregado'
          && changesOnly(['status', 'deliveredAt', 'deliveredByPorteroId', 'deliveredToAuthId', 'deliveredToPerson', 'deliveredToDocument', 'deliveryNotes'])
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.deliveredByPorteroId == request.auth.uid
          && deliveredToAuthorized(request.resource.data.apartmentId, request.resource.data);

        allow delete: if false;

        function deliveredToAuthorized(apartmentId, data) {
          let authPath = /databases/$(database)/documents/condominiums/$(condoId)/apartments/$(apartmentId)/authorized/$(data.deliveredToAuthId);
          return data.deliveredToAuthId is string
            && exists(authPath)
            && get(authPath).data.isActive == true
            && get(authPath).data.fullName == data.deliveredToPerson
            && get(authPath).data.documentId == data.deliveredToDocument;
        }
      }

      // ==========================================
      // RESERVAS (reservations/{reservationId}) — SCRUM-24, SCRUM-28
      // RN-B1 (cruces), RN-B2 (48 h), RN-B3 (1 por mes)
      // ==========================================
      function slots() {
        return {
          'salon_social': {'AM': [8, 14], 'PM': [15, 22]},
          'bbq': {'AM': [10, 16], 'PM': [17, 22]}
        };
      }

      function localTime(date, hour) {
        let parts = date.split('-');
        return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          + duration.value(hour + 5, 'h');
      }

      function monthOf(date) {
        return date.split('-')[0] + '-' + date.split('-')[1];
      }

      function slotLockPath(data) {
        return /databases/$(database)/documents/condominiums/$(condoId)/reservationSlots/$(data.commonArea + '_' + data.date + '_' + data.slot);
      }

      function quotaPath(apartmentId, date) {
        return /databases/$(database)/documents/condominiums/$(condoId)/reservationQuotas/$(apartmentId + '_' + monthOf(date));
      }

      match /reservations/{reservationId} {
        allow read: if hasCondoRole(condoId, 'administradora')
          || (hasCondoRole(condoId, 'residente') && resource.data.apartmentId == myUnitId());

        allow create: if hasCondoRole(condoId, 'residente')
          && request.resource.data.keys().hasOnly(['commonArea', 'apartmentId', 'residentId', 'date', 'slot', 'startTime', 'endTime', 'status', 'createdAt'])
          && request.resource.data.status == 'Pendiente'
          && request.resource.data.residentId == request.auth.uid
          && myUnitId() != null
          && request.resource.data.apartmentId == myUnitId()
          && request.resource.data.createdAt == request.time
          && request.resource.data.commonArea in slots()
          && request.resource.data.slot in slots()[request.resource.data.commonArea]
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.startTime == localTime(request.resource.data.date, slots()[request.resource.data.commonArea][request.resource.data.slot][0])
          && request.resource.data.endTime == localTime(request.resource.data.date, slots()[request.resource.data.commonArea][request.resource.data.slot][1])
          && request.resource.data.startTime >= request.time + duration.value(48, 'h')
          && !exists(slotLockPath(request.resource.data))
          && existsAfter(quotaPath(request.resource.data.apartmentId, request.resource.data.date))
          && getAfter(quotaPath(request.resource.data.apartmentId, request.resource.data.date)).data.reservationId == reservationId;

        allow update: if hasCondoRole(condoId, 'administradora')
          && resource.data.status == 'Pendiente'
          && (request.resource.data.status in ['Aprobada', 'Rechazada'])
          && changesOnly(['status', 'rejectionReason', 'resolvedAt', 'resolvedBy'])
          && (request.resource.data.status != 'Rechazada' || (request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.trim().size() >= 5))
          && (request.resource.data.status != 'Aprobada'
              || (existsAfter(slotLockPath(resource.data))
                  && getAfter(slotLockPath(resource.data)).data.reservationId == reservationId))
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.resolvedBy == request.auth.uid;

        allow delete: if false;
      }

      match /reservationSlots/{slotId} {
        allow read: if inCondo(condoId);
        allow create: if hasCondoRole(condoId, 'administradora')
          && request.resource.data.keys().hasOnly(['reservationId', 'commonArea', 'date', 'slot'])
          && slotId == request.resource.data.commonArea + '_' + request.resource.data.date + '_' + request.resource.data.slot
          && getAfter(/databases/$(database)/documents/condominiums/$(condoId)/reservations/$(request.resource.data.reservationId)).data.status == 'Aprobada';
        allow update: if false;
        allow delete: if hasCondoRole(condoId, 'administradora');
      }

      match /reservationQuotas/{quotaId} {
        allow read: if hasCondoRole(condoId, 'administradora')
          || (hasCondoRole(condoId, 'residente') && myUnitId() != null
              && quotaId.matches('^' + myUnitId() + '_[0-9]{4}-[0-9]{2}$'));
        allow create: if hasCondoRole(condoId, 'residente')
          && request.resource.data.keys().hasOnly(['apartmentId', 'month', 'reservationId'])
          && request.resource.data.apartmentId == myUnitId()
          && quotaId == request.resource.data.apartmentId + '_' + request.resource.data.month
          && getAfter(/databases/$(database)/documents/condominiums/$(condoId)/reservations/$(request.resource.data.reservationId)).data.apartmentId == myUnitId()
          && monthOf(getAfter(/databases/$(database)/documents/condominiums/$(condoId)/reservations/$(request.resource.data.reservationId)).data.date) == request.resource.data.month;
        allow update: if false;
        allow delete: if hasCondoRole(condoId, 'administradora');
      }

      // ==========================================
      // CONTADORES Y RADICACIÓN (counters/pqrs) — SCRUM-31
      // ==========================================
      match /counters/pqrs {
        allow read: if hasCondoRole(condoId, 'residente') || hasCondoRole(condoId, 'administradora');
        // Inicialización en 0 (al crear el conjunto) o 1 (primera radicación).
        allow create: if request.resource.data.keys().hasOnly(['year', 'sequence'])
          && request.resource.data.year is int
          && request.resource.data.sequence in [0, 1]
          && (hasCondoRole(condoId, 'residente')
              || hasCondoRole(condoId, 'administradora')
              || (isActiveUser()
                  && myCondoId() == null
                  && existsAfter(condoPath(condoId))
                  && getAfter(condoPath(condoId)).data.ownerUid == request.auth.uid));
        allow update: if (hasCondoRole(condoId, 'residente') || hasCondoRole(condoId, 'administradora'))
          && request.resource.data.keys().hasOnly(['year', 'sequence'])
          && request.resource.data.year is int
          && request.resource.data.sequence is int
          && ((request.resource.data.year == resource.data.year
               && request.resource.data.sequence == resource.data.sequence + 1)
              || (request.resource.data.year > resource.data.year
                  && request.resource.data.sequence == 1));
        allow delete: if false;
      }

      // ==========================================
      // PQRS (pqrs/{pqrsId}) — SCRUM-31, SCRUM-35 (RN-B6)
      // ==========================================
      match /pqrs/{pqrsId} {
        allow read: if hasCondoRole(condoId, 'administradora')
          || (hasCondoRole(condoId, 'residente') && resource.data.apartmentId == myUnitId());

        allow create: if hasCondoRole(condoId, 'residente')
          && request.resource.data.keys().hasOnly(['ticketNumber', 'apartmentId', 'residentId', 'category', 'subject', 'description', 'status', 'createdAt'])
          && request.resource.data.ticketNumber is string
          && request.resource.data.ticketNumber.matches('^PQ-[0-9]{4}-[0-9]{4}$')
          && myUnitId() != null
          && request.resource.data.apartmentId == myUnitId()
          && request.resource.data.residentId == request.auth.uid
          && request.resource.data.category in ['Peticion', 'Queja', 'Reclamo', 'Sugerencia']
          && isNonEmptyString(request.resource.data.subject)
          && isNonEmptyString(request.resource.data.description)
          && request.resource.data.status == 'Radicada'
          && request.resource.data.createdAt == request.time;

        allow update: if hasCondoRole(condoId, 'administradora')
          && changesOnly(['status', 'officialResponse', 'updatedAt', 'resolvedAt', 'resolvedBy'])
          && ((request.resource.data.status == 'En gestión' && resource.data.status == 'Radicada')
              || (request.resource.data.status == 'Resuelta'
                  && resource.data.status in ['Radicada', 'En gestión']
                  && request.resource.data.officialResponse is string
                  && request.resource.data.officialResponse.trim().size() >= 10
                  && request.resource.data.resolvedBy == request.auth.uid
                  && request.resource.data.resolvedAt == request.time))
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;

        match /history/{historyId} {
          allow read: if hasCondoRole(condoId, 'administradora')
            || (hasCondoRole(condoId, 'residente')
                && exists(/databases/$(database)/documents/condominiums/$(condoId)/pqrs/$(pqrsId))
                && get(/databases/$(database)/documents/condominiums/$(condoId)/pqrs/$(pqrsId)).data.apartmentId == myUnitId());
          allow create: if hasCondoRole(condoId, 'administradora')
            && request.resource.data.keys().hasOnly(['previousStatus', 'newStatus', 'changedBy', 'changedAt', 'comment'])
            && request.resource.data.previousStatus in ['Radicada', 'En gestión']
            && request.resource.data.newStatus in ['En gestión', 'Resuelta']
            && request.resource.data.changedBy == request.auth.uid
            && request.resource.data.changedAt == request.time
            && request.resource.data.comment is string;
          allow update, delete: if false;
        }
      }
    }

    // ==========================================
    // CIERRE POR DEFECTO (SCRUM-46)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
